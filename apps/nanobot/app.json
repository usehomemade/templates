{
  "name": "nanobot",
  "upstream": "HKUDS/nanobot",
  "track": "release",
  "branch": "main",
  "license": "MIT",
  "homepage": "https://github.com/HKUDS/nanobot",
  "description": "Lightweight personal AI agent with a web UI workbench.",
  "setup": "setup.sh",
  "config": {
    "install": [
      "uv venv && uv pip install -e .",
      "cd webui && bun install --frozen-lockfile",
      "bash .homemade/setup.sh"
    ],
    "services": {
      "web": {
        "displayName": "WebUI",
        "cmd": "exec .venv/bin/nanobot webui --dev --no-open --yes",
        "port": 5173,
        "url": true,
        "share": "owner",
        "healthcheck": {
          "path": "/"
        },
        "signInFile": ".homemade/sign-in-link.txt"
      },
      "ws": {
        "displayName": "Gateway WebSocket",
        "port": 8765,
        "url": true,
        "share": "owner"
      }
    }
  }
}

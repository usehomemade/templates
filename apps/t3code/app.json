{
  "name": "T3 Code",
  "upstream": "pingdotgg/t3code",
  "track": "release",
  "branch": "main",
  "license": "MIT",
  "homepage": "https://github.com/pingdotgg/t3code",
  "description": "Minimal web GUI for coding agents (Codex, Claude and others).",
  "setup": "setup.sh",
  "config": {
    "size": "small",
    "install": [
      "pnpm i --frozen-lockfile",
      "bash .homemade/setup.sh"
    ],
    "services": {
      "server": {
        "displayName": "T3 server",
        "cmd": "T3CODE_DEV_AUTH_TOKEN=$(cat ~/.t3-share/token) exec pnpm run dev:server --host 0.0.0.0",
        "port": 13773
      },
      "web": {
        "displayName": "T3 Code",
        "cmd": "cd apps/web && T3CODE_PORT=13773 T3CODE_SINGLE_ORIGIN_DEV=1 T3CODE_DEV_ALLOWED_HOSTS=.onhmmd.com,.onhomemade.com exec pnpm exec vp dev --host 0.0.0.0",
        "port": 5733,
        "url": true,
        "share": "owner",
        "healthcheck": {
          "path": "/"
        },
        "signInFile": ".homemade/sign-in-link.txt"
      }
    }
  }
}

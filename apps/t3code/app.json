{
  "name": "T3 Code",
  "upstream": "pingdotgg/t3code",
  "track": "release",
  "branch": "main",
  "license": "MIT",
  "homepage": "https://github.com/pingdotgg/t3code",
  "description": "Minimal web GUI for coding agents (Codex, Claude and others).",
  "config": {
    "size": "small",
    "env_schema": [
      {
        "key": "T3CODE_DEV_AUTH_TOKEN",
        "generate": true
      },
      {
        "key": "T3CODE_PORT",
        "default": "13773"
      },
      {
        "key": "T3CODE_SINGLE_ORIGIN_DEV",
        "default": "1"
      }
    ],
    "warmup": [
      "pnpm install --frozen-lockfile"
    ],
    "install": [
      "pnpm install --frozen-lockfile"
    ],
    "services": {
      "server": {
        "displayName": "T3 server",
        "cmd": "exec pnpm run dev:server --host 0.0.0.0",
        "port": 13773
      },
      "web": {
        "displayName": "T3 Code",
        "cmd": "cd apps/web && exec pnpm exec vp dev --host 0.0.0.0",
        "port": 5733,
        "url": true,
        "share": "owner",
        "healthcheck": {
          "path": "/"
        },
        "signInUrl": "${HOMEMADE_URL_5733}/pair#token=${T3CODE_DEV_AUTH_TOKEN}"
      }
    }
  }
}

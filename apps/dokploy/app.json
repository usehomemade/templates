{
  "name": "Dokploy",
  "upstream": "Dokploy/dokploy",
  "track": "release",
  "branch": "canary",
  "license": "Apache-2.0",
  "homepage": "https://dokploy.com",
  "description": "Self-hostable PaaS for deploying apps and databases (Next.js dashboard, Docker Swarm and Traefik).",
  "setup": "setup.sh",
  "config": {
    "size": "small",
    "install": [
      "bash .homemade/setup.sh"
    ],
    "services": {
      "web": {
        "displayName": "Dokploy",
        "cmd": "exec pnpm run dokploy:dev",
        "port": 3000,
        "url": true,
        "share": "owner",
        "healthcheck": {
          "path": "/register"
        }
      }
    }
  }
}

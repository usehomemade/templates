{
  "name": "Coolify",
  "upstream": "coollabsio/coolify",
  "track": "release",
  "branch": "v4.x",
  "license": "Apache-2.0",
  "homepage": "https://coolify.io",
  "description": "Self-hostable PaaS to deploy apps, databases and services on your own servers.",
  "setup": "setup.sh",
  "config": {
    "size": "medium",
    "install": [
      "bash .homemade/setup.sh"
    ],
    "services": {
      "web": {
        "displayName": "Coolify",
        "cmd": "exec docker compose -p coolify -f docker-compose.yml -f docker-compose.dev.yml up",
        "port": 8000,
        "url": true,
        "share": "owner",
        "healthcheck": {
          "path": "/login"
        }
      },
      "vite": {
        "displayName": "Vite (assets, live reload)",
        "port": 5173,
        "url": true
      }
    }
  }
}

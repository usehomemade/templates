{
  "name": "OpenCode",
  "upstream": "anomalyco/opencode",
  "track": "release",
  "branch": "dev",
  "license": "MIT",
  "homepage": "https://opencode.ai",
  "description": "Open source AI coding agent with a web UI.",
  "config": {
    "size": "small",
    "warmup": [
      "bun install --frozen-lockfile"
    ],
    "install": [
      "bun install --frozen-lockfile"
    ],
    "services": {
      "web": {
        "displayName": "OpenCode",
        "cmd": "cd packages/opencode && exec bun --watch --no-clear-screen --watch-kill-signal SIGKILL src/index.ts serve --port \"$PORT\" --hostname 0.0.0.0",
        "port": 4096,
        "url": true,
        "share": "owner",
        "healthcheck": {
          "path": "/"
        }
      }
    }
  }
}

{
  "name": "OpenCode",
  "upstream": "anomalyco/opencode",
  "track": "release",
  "branch": "dev",
  "license": "MIT",
  "homepage": "https://opencode.ai",
  "description": "Open source AI coding agent with a web UI.",
  "setup": "setup.sh",
  "config": {
    "size": "small",
    "install": [
      "bun install --frozen-lockfile",
      "bash .homemade/setup.sh"
    ],
    "services": {
      "api": {
        "displayName": "OpenCode server",
        "cmd": "exec bun dev serve --port 4096 --hostname 127.0.0.1"
      },
      "web": {
        "displayName": "OpenCode",
        "cmd": "cd packages/app && exec bunx vite --config vite.homemade.config.ts --port 3000 --host 0.0.0.0",
        "port": 3000,
        "url": true,
        "share": "owner",
        "healthcheck": {
          "path": "/"
        }
      }
    }
  }
}
